# Session signing secret (required in production / Vercel).
# Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Database ---
# Production (Vercel): Postgres connection string (Neon-friendly).
# Example: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL=postgresql://…

# Local default: SQLite file (node:sqlite). Used when DATABASE_URL is unset
# or not a postgres:// URL.
# DATABASE_PATH=./data/easie.db
# DATABASE_URL=file:./data/easie.db

# --- Mercado Livre (Fase 4 · Pegar produtos) ---
# Official Highlights API needs a bearer token from your ML app.
# Without credentials the app uses public search when possible, then a demo list.
# Never commit real secrets. Bind them in Vercel / Cursor Dashboard / .env.local.
#
# ML_ACCESS_TOKEN=
# MERCADOLIBRE_ACCESS_TOKEN=   # alias of ML_ACCESS_TOKEN
# ML_APP_ID=                   # application id (docs / future OAuth)
# ML_CLIENT_ID=                # alias of ML_APP_ID
# ML_CLIENT_SECRET=
# ML_SITE_ID=MLB
# ML_REFRESH_CADENCE=weekly    # weekly | daily (peak seasons)
# ML_CATEGORIES=MLB1055:Celulares,MLB1000:Eletrônicos
